NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:@127.0.0.1:3306/workstracker"
# Ganti dengan string acak panjang (mis. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET="change-me"
# Daftar origin yang diizinkan, dipisah koma
CORS_ORIGINS="http://localhost:5173"
# Lokasi file CV (CV Saya)
UPLOAD_DIR=storage/uploads
# URL aplikasi (dipakai di tautan email)
APP_URL="http://localhost:5173"
# Pengingat email harian (jam WIB). Kosongkan SMTP_HOST = email hanya disimpan di storage/mail-preview
REMINDER_HOUR=7
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorksTracker <no-reply@domainkamu.com>"
# AI Career Assistant (add-on). Kosongkan = fitur AI menampilkan "belum dikonfigurasi".
# Gemini API (Google AI Studio → Get API key). Aktifkan billing (paid tier) agar data pengguna tidak dipakai melatih model.
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-pro-preview
# AI_FAKE=1 → provider palsu untuk development/E2E (tanpa biaya, hasil contoh)
AI_FAKE=

# Push notification PWA (buat otomatis: npm run push:keys -w api)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@domain-kamu.com

# Pembayaran otomatis Midtrans (dashboard.midtrans.com > Settings > Access Keys). Kosong = beli lewat WhatsApp.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Development tanpa Midtrans: PAYMENT_FAKE=1 (simulasi bayar)
